#!/bin/sh /etc/rc.common
# The daemon under procd, as the systemd unit has it: not started until
# /etc/mdnsd.conf exists, run as the unprivileged mdnsd, and given up on if
# it keeps failing at once.

START=50
STOP=10
USE_PROCD=1

CONF=/etc/mdnsd.conf

start_service() {
	[ -f "$CONF" ] || {
		logger -t mdnsd "no $CONF: not starting"
		return 0
	}
	# The control socket's directory, which anyone may use mdnsctl in.
	mkdir -p /var/run/mdnsd
	chown mdnsd:mdnsd /var/run/mdnsd
	chmod 0755 /var/run/mdnsd

	procd_open_instance
	procd_set_param command /usr/bin/mdnsd "$CONF"
	procd_set_param user mdnsd
	procd_set_param stderr 1
	# After a crash: restarted, unless it crashes five times within an hour.
	procd_set_param respawn 3600 5 5
	procd_set_param file "$CONF"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger mdnsd
}
