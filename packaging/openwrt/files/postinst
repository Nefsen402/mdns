#!/bin/sh
# The user mdnsd runs as, if there is not one, then what every package does:
# enable the init script, and start it, on a running system.
if ! grep -q '^mdnsd:' "${IPKG_INSTROOT}/etc/passwd"; then
	grep -q '^mdnsd:' "${IPKG_INSTROOT}/etc/group" ||
		echo 'mdnsd:x:5353:' >>"${IPKG_INSTROOT}/etc/group"
	echo 'mdnsd:x:5353:5353:mdnsd:/var/run/mdnsd:/bin/false' >>"${IPKG_INSTROOT}/etc/passwd"
fi
[ "${IPKG_NO_SCRIPT}" = "1" ] && exit 0
[ -s "${IPKG_INSTROOT}/lib/functions.sh" ] || exit 0
. "${IPKG_INSTROOT}/lib/functions.sh"
default_postinst "$0" "$@"
