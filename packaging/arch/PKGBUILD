# Maintainer: Alex <alex@mapleprecision.com>
#
# Builds from the working tree this file lives in (there is no upstream
# tarball): run `makepkg -f` from this directory (packaging/arch). The build
# happens here and not at the project root, because makepkg's default source
# directory, ./src, would otherwise be the project's own Rust sources.
pkgname=mdnsd
pkgver=0.1.0
pkgrel=1
pkgdesc='mDNS discovery and per-segment reflection daemon, with the mdnsctl client'
arch=('x86_64' 'aarch64')
license=('GPL-3.0-only')
depends=('glibc' 'gcc-libs')
makedepends=('cargo')

_cargo_target() {
  # Keep build output out of the source tree.
  export CARGO_TARGET_DIR="$srcdir/target"
}

prepare() {
  cd "$startdir/../.."
  _cargo_target
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$startdir/../.."
  _cargo_target
  cargo build --frozen --release
}

check() {
  cd "$startdir/../.."
  _cargo_target
  cargo test --frozen --release
}

package() {
  cd "$startdir/../.."
  _cargo_target

  install -Dm755 "$CARGO_TARGET_DIR/release/mdnsd" "$pkgdir/usr/bin/mdnsd"
  install -Dm755 "$CARGO_TARGET_DIR/release/mdnsctl" "$pkgdir/usr/bin/mdnsctl"

  install -Dm644 man/mdnsctl.1 "$pkgdir/usr/share/man/man1/mdnsctl.1"
  install -Dm644 man/mdnsd.conf.5 "$pkgdir/usr/share/man/man5/mdnsd.conf.5"
  install -Dm644 man/mdnsd.8 "$pkgdir/usr/share/man/man8/mdnsd.8"

  install -Dm644 systemd/mdnsd.service "$pkgdir/usr/lib/systemd/system/mdnsd.service"
  install -Dm644 systemd/mdnsd.sysusers "$pkgdir/usr/lib/sysusers.d/mdnsd.conf"
}
