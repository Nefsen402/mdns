[Unit]
Description=mDNS discovery and reflection daemon
Documentation=man:mdnsd(8) man:mdnsd.conf(5) man:mdnsctl(1)
After=network.target
# Nothing to do until the segments have been configured.
ConditionPathExists=/etc/mdnsd.conf

[Service]
Type=exec
ExecStart=/usr/bin/mdnsd /etc/mdnsd.conf
# The config is read once at startup; SIGTERM makes the daemon send goodbyes
# for everything it reflected, then exit. It is not restarted if it exits with
# an error: interfaces that appear late are waited for, so a failure is a fault
# to look into (systemctl status mdnsd), not something to retry past. A panic
# aborts it (panic = "abort" in Cargo.toml), and it is restarted after that,
# with the panic in the journal; one that keeps crashing at once is given up
# on after five tries.
Restart=on-abort

# Unprivileged: port 5353 is unprivileged and binding a socket to one
# interface needs no capability on Linux 5.7 or newer.
User=mdnsd
Group=mdnsd
# Creates /run/mdnsd for the control socket; members of the mdnsd group can
# reach it with mdnsctl.
RuntimeDirectory=mdnsd
RuntimeDirectoryMode=0750
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
# AF_NETLINK: to follow interfaces as they come and go (VLANs and Wi-Fi often
# appear after the network target, or are recreated).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
